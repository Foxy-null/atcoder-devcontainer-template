{
  "name": "AtCoder C++23 (Ubuntu 24.04 / GCC 15.2.0)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "vscode",
      "USER_UID": "1000",
      "USER_GID": "1000",
      "ATCODER_CLI_VERSION": "2.2.0",
      "ONLINE_JUDGE_TOOLS_VERSION": "11.5.1",
      "ACLOGIN_VERSION": "0.2.1"
    }
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "mounts": [
    "source=atcoder-${devcontainerId}-acc-config,target=/home/vscode/.config/atcoder-cli-nodejs,type=volume",
    "source=atcoder-${devcontainerId}-oj-data,target=/home/vscode/.local/share/online-judge-tools,type=volume"
  ],
  "postCreateCommand": "setup-atcoder-user && verify-atcoder-toolchain",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "-GitHub.copilot",
        "-GitHub.copilot-chat",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "C_Cpp.default.cppStandard": "c++23",
        "C_Cpp.default.compilerPath": "/opt/atcoder/gcc/bin/g++",
        "[cpp]": {
          "editor.defaultFormatter": "ms-vscode.cpptools"
        },
        "files.associations": {
          "*.hpp": "cpp",
          "source_location": "cpp",
          "all": "cpp"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/atcoder/gcc/include",
          "/opt/atcoder/gcc/include/torch/csrc/api/include"
        ],
        "C_Cpp.default.defines": [
          "ATCODER",
          "ONLINE_JUDGE",
          "NOMINMAX",
          "OR_PROTO_DLL=",
          "PROTOBUF_USE_DLLS",
          "USE_BOP",
          "USE_CBC",
          "USE_CLP",
          "USE_GLOP",
          "USE_LP_PARSER",
          "USE_MATH_OPT",
          "USE_PDLP",
          "USE_SCIP"
        ]
      }
    }
  },
  "containerEnv": {
    "ATCODER_REPOSITORY_CONFIG_DIR": "${containerWorkspaceFolder}/config"
  }
}
