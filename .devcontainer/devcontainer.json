{
  "name": "AtCoder C++23 (Ubuntu 24.04 / GCC 15.2.0)",
  "image": "ghcr.io/foxy-null/atcoder-devcontainer-template@sha256:ccac5442441df99b2b7ddf271c7e9a28142335a761e628777ca286fd634f6300",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "mounts": [
    "source=atcoder-${devcontainerId}-acc-config,target=/home/vscode/.config/atcoder-cli-nodejs,type=volume",
    "source=atcoder-${devcontainerId}-oj-data,target=/home/vscode/.local/share/online-judge-tools,type=volume"
  ],
  "postCreateCommand": "setup-atcoder-user && verify-atcoder-toolchain",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "-GitHub.copilot",
        "-GitHub.copilot-chat",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "C_Cpp.default.cppStandard": "c++23",
        "C_Cpp.default.compilerPath": "/opt/atcoder/gcc/bin/g++",
        "[cpp]": {
          "editor.defaultFormatter": "ms-vscode.cpptools"
        },
        "files.associations": {
          "*.hpp": "cpp",
          "source_location": "cpp",
          "all": "cpp"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/atcoder/gcc/include",
          "/opt/atcoder/gcc/include/torch/csrc/api/include"
        ],
        "C_Cpp.default.defines": [
          "ATCODER",
          "ONLINE_JUDGE",
          "NOMINMAX",
          "OR_PROTO_DLL=",
          "PROTOBUF_USE_DLLS",
          "USE_BOP",
          "USE_CBC",
          "USE_CLP",
          "USE_GLOP",
          "USE_LP_PARSER",
          "USE_MATH_OPT",
          "USE_PDLP",
          "USE_SCIP"
        ]
      }
    }
  },
  "containerEnv": {
    "ATCODER_REPOSITORY_CONFIG_DIR": "${containerWorkspaceFolder}/config"
  }
}
